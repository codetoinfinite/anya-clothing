{
  "name": "byshree-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:storefront": "pnpm --filter @byshree/storefront dev",
    "dev:backend": "pnpm --filter @byshree/backend dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "seed": "pnpm --filter @byshree/backend run seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
