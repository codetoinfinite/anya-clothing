# =========================================================================
# byshree — environment variables
# Copy to .env (root), apps/storefront/.env.local, apps/backend/.env
# Values below are dev defaults wired to infra/docker-compose.yml
# =========================================================================

# ---- Storefront (Next.js) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Aanya
NEXT_PUBLIC_BRAND_TAGLINE=Heritage. Reimagined.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_BASE_CURRENCY=inr
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Admin (Next.js, served at /admin) ----
MEDUSA_BACKEND_URL=http://localhost:9000
ADMIN_COOKIE_NAME=byshree_admin
# Injected on Vercel by the admin -> storefront service binding; set by hand only for plain `pnpm dev`.
STOREFRONT_URL=http://localhost:3000
# Shared by admin (sender) and storefront /api/revalidate (receiver).
REVALIDATE_SECRET=replace-with-a-long-random-string

# ---- Medusa backend ----
NODE_ENV=development
PORT=9000
MEDUSA_ADMIN_ONBOARDING_TYPE=default
DATABASE_URL=postgres://byshree:byshree_dev@localhost:5432/byshree
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-long-random-string
COOKIE_SECRET=replace-with-long-random-string
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000

# ---- AWS S3 (production media) ----
# For local dev, MinIO below is used as S3-compatible.
S3_REGION=ap-south-1
S3_BUCKET=byshree-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FILE_URL=
S3_CACHE_CONTROL=public, max-age=31536000, immutable

# ---- Local MinIO (S3-compatible for dev) ----
MINIO_ENDPOINT=http://localhost:9100
MINIO_ACCESS_KEY=byshree
MINIO_SECRET_KEY=byshree_dev_minio
MINIO_BUCKET=byshree-media
MINIO_PUBLIC_URL=http://localhost:9100/byshree-media

# ---- Search ----
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=byshree_meili_dev_key

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email ----
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---- Unsplash (optional: pull placeholder imagery) ----
UNSPLASH_ACCESS_KEY=
